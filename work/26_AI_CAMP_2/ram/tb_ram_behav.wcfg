         <obj_property name="ObjectShortName">w_rptr[1:0]</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_fifo/dut/U_REG_FILE/we" type="logic">
         <obj_property name="ElementShortName">we</obj_property>
         <obj_property name="ObjectShortName">we</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_fifo/dut/U_REG_FILE/register_file" type="array">
         <obj_property name="ElementShortName">register_file[0:3][7:0]</obj_property>
         <obj_property name="ObjectShortName">register_file[0:3][7:0]</obj_property>
