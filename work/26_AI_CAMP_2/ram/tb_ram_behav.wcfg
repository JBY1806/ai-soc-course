<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="tb_fifo_behav.wdb" id="1">
         <top_modules>
            <top_module name="glbl" />
            <top_module name="tb_fifo" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="2,512.500 ns"></ZoomStartTime>
      <ZoomEndTime time="2,869.501 ns"></ZoomEndTime>
      <Cursor1Time time="2,810.000 ns"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="202"></NameColumnWidth>
      <ValueColumnWidth column_width="90"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="9" />
   <wave_markers>
      <marker time="5000" label="" />
   </wave_markers>
   <wvobject fp_name="/tb_fifo/clk" type="logic">
      <obj_property name="ElementShortName">clk</obj_property>
      <obj_property name="ObjectShortName">clk</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_fifo/rst" type="logic">
      <obj_property name="ElementShortName">rst</obj_property>
      <obj_property name="ObjectShortName">rst</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_fifo/push" type="logic">
      <obj_property name="ElementShortName">push</obj_property>
      <obj_property name="ObjectShortName">push</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_fifo/pop" type="logic">
      <obj_property name="ElementShortName">pop</obj_property>
      <obj_property name="ObjectShortName">pop</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_fifo/push_data" type="array">
      <obj_property name="ElementShortName">push_data[7:0]</obj_property>
      <obj_property name="ObjectShortName">push_data[7:0]</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_fifo/pop_data" type="array">
      <obj_property name="ElementShortName">pop_data[7:0]</obj_property>
      <obj_property name="ObjectShortName">pop_data[7:0]</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_fifo/full" type="logic">
      <obj_property name="ElementShortName">full</obj_property>
      <obj_property name="ObjectShortName">full</obj_property>
   </wvobject>
   <wvobject fp_name="/tb_fifo/empty" type="logic">
      <obj_property name="ElementShortName">empty</obj_property>
      <obj_property name="ObjectShortName">empty</obj_property>
   </wvobject>
   <wvobject fp_name="group988" type="group">
      <obj_property name="label">FIFO</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="isExpanded"></obj_property>
      <wvobject fp_name="/tb_fifo/dut/w_wptr" type="array">
         <obj_property name="ElementShortName">w_wptr[1:0]</obj_property>
         <obj_property name="ObjectShortName">w_wptr[1:0]</obj_property>
      </wvobject>
      <wvobject fp_name="/tb_fifo/dut/w_rptr" type="array">
